<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B3E9F4"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TODAY"
        android:id="@+id/today"
        android:textColor="#0A2742"
        android:textSize="55sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="20dp"
        android:layout_marginStart="24dp"
        />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bar"
        android:layout_width="355dp"
        android:layout_height="37dp"
        app:cardBackgroundColor="#3C7AB1"
        app:cardCornerRadius="13dp"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toBottomOf="@id/today"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="5dp"
        />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/barTop"
        android:layout_width="300dp"
        android:layout_height="37dp"
        app:cardBackgroundColor="#3CC560"
        app:cardCornerRadius="13dp"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toBottomOf="@id/today"
        app:layout_constraintStart_toStartOf="@id/bar"
        android:layout_marginTop="5dp"
        />

    <Button
        android:id="@+id/logButton"
        android:layout_width="140dp"
        android:layout_height="55dp"
        android:text="LOG WATER"
        android:textColor="#B3E9F4"
        android:backgroundTint="#0A2742"
        app:layout_constraintTop_toBottomOf="@id/bar"
        android:layout_marginTop="10dp"

        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="35dp"

        app:cornerRadius="0dp"
        />

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        />

    <View
        android:id="@+id/water"
        android:layout_width="wrap_content"
        android:layout_height="100dp"
        android:background="#3C7AB1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />

    <LinearLayout
        android:id="@+id/soil"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_width="wrap_content"
        android:layout_height="60dp"
        app:layout_constraintBottom_toTopOf="@id/water"
        android:orientation="horizontal">

        <View
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:background="#4E2315"
            />

        <View
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:background="#693B2C"
            />

        <View
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:background="#4E2315"
            />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/potBottom"
        android:layout_width="100dp"
        android:layout_height="50dp"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        app:layout_constraintBottom_toTopOf="@id/soil"
        android:orientation="horizontal">

        <View
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:background="#CD6B42"
            />

        <View
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:background="#BC5A37"
            />
    </LinearLayout>

    <View
        android:id="@+id/potShadow"
        android:layout_width="100dp"
        android:layout_height="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/potBottom"
        android:background="#9B3F1E"
        />

    <View
        android:id="@+id/potBrim"
        android:layout_width="140dp"
        android:layout_height="35dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/potShadow"
        android:background="#CD6A43"
        />

    <ImageView
        android:layout_width="200dp"
        android:layout_height="70dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="200dp"
        android:src="@drawable/mask_group"/>


</androidx.constraintlayout.widget.ConstraintLayout>